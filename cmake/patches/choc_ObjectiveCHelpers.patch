--- choc/platform/choc_ObjectiveCHelpers.h.orig	2025-08-15 17:53:30
+++ choc/platform/choc_ObjectiveCHelpers.h	2025-08-15 17:53:51
@@ -19,6 +19,9 @@
 #ifndef CHOC_OBJC_HELPERS_HEADER_INCLUDED
 #define CHOC_OBJC_HELPERS_HEADER_INCLUDED
 
+#include <atomic>
+#include <chrono>
+#include <unistd.h>
 #include "choc_Platform.h"
 
 #if CHOC_APPLE
@@ -129,12 +132,30 @@
     //==============================================================================
     /// Creates a delegate class from a base. A random suffix will be added to the
     /// new class name provided, to avoid clashes in the global namespace.
+    /// Enhanced version with better uniqueness for AU plugin environments
     inline Class createDelegateClass (const char* baseClass, const char* newClassName)
     {
+        static std::atomic<uint32_t> counter{0};
         auto time = std::chrono::high_resolution_clock::now().time_since_epoch();
         auto micros = std::chrono::duration_cast<std::chrono::microseconds> (time).count();
-        auto uniqueDelegateName = newClassName + std::to_string (static_cast<uint32_t> (micros));
+        auto processId = getpid();
+        auto instanceCounter = counter.fetch_add(1);
+        
+        // Create highly unique name with multiple entropy sources
+        auto uniqueDelegateName = std::string(newClassName) + "_" 
+                                + std::to_string(processId) + "_"
+                                + std::to_string(static_cast<uint32_t>(micros)) + "_"
+                                + std::to_string(instanceCounter);
+        
         auto c = objc_allocateClassPair (objc_getClass (baseClass), uniqueDelegateName.c_str(), 0);
+        
+        // Enhanced error handling for AU environments
+        if (!c) {
+            // Retry with even more unique naming if first attempt fails
+            uniqueDelegateName += "_retry_" + std::to_string(std::rand());
+            c = objc_allocateClassPair (objc_getClass (baseClass), uniqueDelegateName.c_str(), 0);
+        }
+        
         CHOC_ASSERT (c);
         return c;
     }
